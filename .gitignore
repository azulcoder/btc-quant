__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
data/*.csv
data/*.json
# Tick collector store (DESIGN-orderflow-terminal.md §3 + §3c) — local research
# history: the legacy single file, the §3c per-UTC-day rotation directory, and
# their WALs. Never committed.
data/ticks.duckdb
data/ticks/
data/*.duckdb.wal
# Archive-pipeline staging (scripts/archive_ticks.py — DESIGN §3 data lifecycle):
# parquet exports + manifests bound for GitHub Releases, plus the prune/rebuild
# side files. Large, regenerable, never committed.
data/archive/
# M1 order-flow bar cache (btcquant/orderflow.py) — derived, spec-hashed, and
# re-buildable from the day files / HF mirror; never a source of truth.
data/orderflow/
# M7 public-archive partition (scripts/ingest_vision.py — DESIGN §3d): Binance's
# own published aggTrades, re-fetchable at any time from data.binance.vision and
# checksum-gated on arrival. ~13 GB of parquet for the full history, and a
# SEPARATE tree from data/ticks/ on purpose — never committed.
data/vision/
data/*.duckdb.rebuild
data/*.pre-archive.bak
.DS_Store
.venv/
venv/
*.png

# Optional research/reproducibility tooling (requirements-dev.txt) — local-only stores.
# DVC pipeline outputs under reports/ are ignored by DVC's own reports/.gitignore.
mlflow.db
mlartifacts/
mlruns/

# Browser-verification artifacts (scripts/verify_terminal_browser.py) —
# screenshots of the fixture-replay terminal, regenerated on every run.
reports/verify/

# O-5 econ-calendar local mirror (DESIGN-orderflow-terminal.md §4e): written by
# scripts/fetch_econ.py (`make econ`) because faireconomy serves no CORS header —
# machine-local, re-fetchable, never committed.
dashboard/econ_calendar.json
data/hf-stage/manifests/
data/hf-stage/

# GCP collector deploy (deploy/gcp/): the real env file carries the HF write token.
# Only env.example is committed. Never the filled-in env.
deploy/gcp/env

# Collector stdout (make collector-api > data/collector.log). Machine-local
# operational log: the WATCHDOG lines that a terminal-only run throws away.
data/*.log
.tmp/

# Copyrighted reference material (docs/EXTRACT-*.md, grep `Aturan hak cipta`).
# This repo is PUBLIC. Source texts are read locally and NEVER committed — the
# extraction documents carry only equations restated in this repo's notation plus
# own-words prose, with section-number citations. A blanket rule, not a per-file
# one, so a new source cannot arrive uncovered.
refs/
*.pdf
*.djvu
*.epub

# Settled funding history, re-pullable from each venue public REST at any time by
# scripts/backfill_funding_history.py. Append-only locally; not a source of truth.
data/funding_history/
